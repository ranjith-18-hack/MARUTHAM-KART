# MARUTHAM KART — Backend Environment Configuration Template
# Copy this file to .env and configure values for your environment.

# Database: Supabase PostgreSQL direct or pooler connection URL
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Security: Strong random 256-bit secret for JWT signing (generate with `openssl rand -hex 32`)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS: Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-production-app.domain.com

# Server Environment: production / development
ENVIRONMENT=production
